{
  "agent_id": "billing_support",
  "name": "Billing Support Specialist",
  "description": "Handles billing questions, duplicate charge investigations, payment issues, and invoice inquiries using verified transaction records.",
  "version": "1.1.0",
  "agent_type": "specialist",
  "capabilities": [
    "explain_billing_issues",
    "investigate_duplicate_charge_questions",
    "assist_with_payment_questions",
    "explain_invoice_information",
    "look_up_customer_transactions"
  ],
  "available_tools": [
    "find_customer_transactions"
  ],
  "permissions": {
    "can_handle_billing_requests": true,
    "can_route_requests": false,
    "can_modify_customer_data": false,
    "can_read_customer_transactions": true,
    "can_issue_refunds": false,
    "can_access_full_payment_card_details": false
  },
  "governance": {
    "transaction_facts_must_come_from_database": true,
    "similar_transactions_are_not_proof_of_duplicate_charge": true,
    "unverified_issues_require_human_review": true,
    "database_failures_require_escalation": true,
    "never_request_full_card_number_or_cvv": true
  },
  "status": "active"
}